{
  "name": "push/pull sequence: the server assigns seq; pull returns ALL later ops, not just the last one per id",
  "initial": {
    "head_seq": 0
  },
  "steps": [
    {
      "action": "push",
      "ops": [
        {
          "op_id": "aa000000000000000000000000000001",
          "device_id": "dev_tablet",
          "kind": "obj",
          "wire_id": "6f85020f85506181e573ce22c245d578",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIGRlIG9iamV0bzsxPg=="
        },
        {
          "op_id": "aa000000000000000000000000000002",
          "device_id": "dev_tablet",
          "kind": "obj",
          "wire_id": "417794695851bd508d25f135e539b56a",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIGRlIGV0aXF1ZXRhOzE+"
        },
        {
          "op_id": "aa000000000000000000000000000003",
          "device_id": "dev_tablet",
          "kind": "type",
          "wire_id": "a872162d777ca2d56908fffe5773a781",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIGRlbCB0aXBvOzE+"
        }
      ],
      "expect": {
        "results": [
          {
            "op_id": "aa000000000000000000000000000001",
            "seq": 1
          },
          {
            "op_id": "aa000000000000000000000000000002",
            "seq": 2
          },
          {
            "op_id": "aa000000000000000000000000000003",
            "seq": 3
          }
        ],
        "head_seq": 3
      }
    },
    {
      "action": "pull",
      "since_seq": 0,
      "expect": {
        "seqs": [
          1,
          2,
          3
        ],
        "op_ids": [
          "aa000000000000000000000000000001",
          "aa000000000000000000000000000002",
          "aa000000000000000000000000000003"
        ],
        "head_seq": 3,
        "has_more": false,
        "note": "a new device sees ALL ops, without dedup by wire_id"
      }
    },
    {
      "action": "push",
      "ops": [
        {
          "op_id": "bb000000000000000000000000000001",
          "device_id": "dev_pc",
          "kind": "obj",
          "wire_id": "6f85020f85506181e573ce22c245d578",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIGRlIG9iamV0bzsxPiBlZGl0YWRvPg=="
        }
      ],
      "expect": {
        "results": [
          {
            "op_id": "bb000000000000000000000000000001",
            "seq": 4
          }
        ],
        "head_seq": 4
      }
    },
    {
      "action": "pull",
      "since_seq": 3,
      "expect": {
        "seqs": [
          4
        ],
        "op_ids": [
          "bb000000000000000000000000000001"
        ],
        "head_seq": 4,
        "has_more": false,
        "note": "the incremental pull only sees what is new"
      }
    },
    {
      "action": "pull",
      "since_seq": 0,
      "expect": {
        "seqs": [
          1,
          2,
          3,
          4
        ],
        "op_ids": [
          "aa000000000000000000000000000001",
          "aa000000000000000000000000000002",
          "aa000000000000000000000000000003",
          "bb000000000000000000000000000001"
        ],
        "head_seq": 4,
        "has_more": false
      }
    }
  ]
}
