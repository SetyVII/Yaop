{
  "name": "compaction: only below the bootstrap snapshot's covered_seq; a pull below the floor returns oplog_compacted, never a gap",
  "initial": {
    "head_seq": 0
  },
  "steps": [
    {
      "action": "push",
      "ops": [
        {
          "op_id": "dd000000000000000000000000000001",
          "device_id": "dev_pc",
          "kind": "obj",
          "wire_id": "6f85020f85506181e573ce22c245d578",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIDE+"
        },
        {
          "op_id": "dd000000000000000000000000000002",
          "device_id": "dev_pc",
          "kind": "obj",
          "wire_id": "417794695851bd508d25f135e539b56a",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIDI+"
        },
        {
          "op_id": "dd000000000000000000000000000003",
          "device_id": "dev_pc",
          "kind": "obj",
          "wire_id": "a872162d777ca2d56908fffe5773a781",
          "key_epoch": 1,
          "blob": "PGVudmVsb3BlIDM+"
        }
      ],
      "expect": {
        "results": [
          {
            "op_id": "dd000000000000000000000000000001",
            "seq": 1
          },
          {
            "op_id": "dd000000000000000000000000000002",
            "seq": 2
          },
          {
            "op_id": "dd000000000000000000000000000003",
            "seq": 3
          }
        ],
        "head_seq": 3
      }
    },
    {
      "action": "push",
      "comment": "the trusted node uploads the bootstrap snapshot covering ops 1..3",
      "ops": [
        {
          "op_id": "dd0000000000000000000000000000bb",
          "device_id": "dev_pc",
          "kind": "snapshot",
          "wire_id": "e5e70a1901b8e37c6f4b8a2c9c0b1e02",
          "key_epoch": 1,
          "blob": "PEJPT1RTVFJBUD4="
        }
      ],
      "expect": {
        "results": [
          {
            "op_id": "dd0000000000000000000000000000bb",
            "seq": 4
          }
        ],
        "head_seq": 4
      }
    },
    {
      "action": "promote_bootstrap",
      "op_id": "dd0000000000000000000000000000bb",
      "covered_seq": 3,
      "expect": {
        "ok": true
      }
    },
    {
      "action": "status",
      "expect": {
        "protocol_version": "1",
        "vault": "vault_test",
        "head_seq": 4,
        "compact_floor": 3,
        "bootstrap_seq": 4,
        "device_id": "dev_tablet"
      }
    },
    {
      "action": "pull",
      "since_seq": 3,
      "expect": {
        "seqs": [
          4
        ],
        "op_ids": [
          "dd0000000000000000000000000000bb"
        ],
        "head_seq": 4,
        "has_more": false
      }
    },
    {
      "action": "pull",
      "since_seq": 2,
      "expect_error": {
        "code": "oplog_compacted",
        "compact_floor": 3,
        "bootstrap": {
          "covered_seq": 3,
          "seq": 4
        }
      }
    },
    {
      "action": "compact",
      "expect": {
        "ok": true
      },
      "comment": "the server deletes ops with seq <= floor; NEVER above covered_seq"
    },
    {
      "action": "pull",
      "since_seq": 0,
      "expect_error": {
        "code": "oplog_compacted",
        "compact_floor": 3,
        "bootstrap": {
          "covered_seq": 3,
          "seq": 4
        },
        "note": "a new device starts from /v1/sync/bootstrap with this information"
      }
    },
    {
      "action": "status",
      "expect": {
        "protocol_version": "1",
        "vault": "vault_test",
        "head_seq": 4,
        "compact_floor": 3,
        "bootstrap_seq": 4,
        "device_id": "dev_tablet"
      }
    }
  ]
}
