<?xml version="1.0" encoding="utf-8"?>
<!-- The database and media are encrypted with a Keystore key that is not in the backup:
     restoring them is useless and exposes encrypted data. Nothing is backed up to the cloud. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
