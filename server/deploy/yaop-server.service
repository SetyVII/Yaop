# yaop-server as a systemd service. Listens on localhost only; put Caddy (deploy/Caddyfile) in front for TLS.
# Install: sudo useradd --system --home /var/lib/yaop-server --shell /usr/sbin/nologin yaop
#          sudo cp yaop-server.service /etc/systemd/system/ && sudo systemctl enable --now yaop-server
[Unit]
Description=YAOP sync server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yaop
Group=yaop
ExecStart=/usr/local/bin/yaop-server -listen 127.0.0.1:8765 -data-dir /var/lib/yaop-server -mdns=false
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
UMask=0077
MemoryHigh=50%
MemoryMax=65%
IPAddressAllow=localhost
IPAddressDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/yaop-server
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
